{
  "enabledPlugins": {
    "dotnet@dotnet-agent-skills": true,
    "dotnet-aspnetcore@dotnet-agent-skills": true,
    "dotnet-msbuild@dotnet-agent-skills": true,
    "dotnet-test@dotnet-agent-skills": true,
    "dotnet-diag@dotnet-agent-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_implementation.py\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit_gate.py\"" }]
      }
    ]
  }
}
